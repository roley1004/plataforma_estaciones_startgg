# ============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL Local en puerto 5432)
# Reemplaza TU_PASSWORD_AQUI con la contraseña de tu usuario postgres
# ============================================================================
DATABASE_URL="postgresql://postgres:TU_PASSWORD_AQUI@localhost:5432/plataforma_startgg?schema=public"

# ============================================================================
# SERVIDOR Y SEGURIDAD (JWT)
# ============================================================================
PORT=4000
JWT_SECRET="super_secret_jwt_key_cambiar_en_produccion_2026"
FRONTEND_URL="http://localhost:3000"

# ============================================================================
# START.GG API (Opcional en Modo Offline / Requerido para sincronizar Start.gg)
# Con este Token del Sistema los organizadores pueden leer cualquier torneo
# pegando solo la URL o ID sin necesidad de vincular su cuenta personal.
# ============================================================================
STARTGG_API_URL="https://api.start.gg/gql/alpha"
STARTGG_SYSTEM_API_TOKEN=""

# ============================================================================
# BOT DE DISCORD (Opcional - Módulo 8)
# ============================================================================
DISCORD_BOT_TOKEN=""
